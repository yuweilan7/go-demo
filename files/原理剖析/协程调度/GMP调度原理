        checkTimers(pp, 0)

        var gp *g
        var inheritTime bool
        ......
        if gp == nil {    // 说明不在 GC
                // 每调度 61 次，就检查一次全局队列，保证公平性；否则两个 Goroutine 可以通过互换，一直占领本地的 runqueue
                if _g_.m.p.ptr().schedtick%61 == 0 && sched.runqsize > 0 {
                        lock(&sched.lock)
                        gp = globrunqget(_g_.m.p.ptr(), 1)     // 从全局队列中偷 g
                        unlock(&sched.lock)
                }
