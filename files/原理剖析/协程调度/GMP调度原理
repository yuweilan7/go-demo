                gcstopm()
                goto top
        }
        if pp.runSafePointFn != 0 {  // 不等于0，说明在安全点
                runSafePointFn()
        }

        // 如果 G 所在的 M 在自旋，说明其P运行队列为空，如果不为空，则应该甩出错误
        if _g_.m.spinning && (pp.runnext != 0 || pp.runqhead != pp.runqtail) {
                throw("schedule: spinning with local work")
        }
