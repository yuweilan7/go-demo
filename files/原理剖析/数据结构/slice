6. 深度拷贝
我们从上面的一些解释就可以看到，切片的传递，底层数组是浅拷贝（操作原来切片会影响新切片），那么有没有深度拷贝的方法呢？
package main

import (
    "fmt"
    "reflect"
    "unsafe"
)

func main() {
    var s1 = []int{1, 2, 3}
    var s2 []int = make([]int, len(s1))
    // copy 函数：将s1的元素复制到s2中，复制多少个元素呢？ min(len(s1), len(s2))

    copy(s2, s1)
    PrintSliceStruct(&s1)
    PrintSliceStruct(&s2)

}

// PrintSliceStruct 打印slice的结构
func PrintSliceStruct(s *[]int) {
    // 代码 将slice 转换成 reflect.SliceHeader
    ss := (*reflect.SliceHeader)(unsafe.Pointer(s))

    // 查看slice的结构
    fmt.Printf("slice struct: %+v, slice is %v\n", ss, s)
}
