8、channel发送和接收元素的本质是什么？
值的拷贝
示例代码：
package main
import (
"fmt"
"time"
)

func print(u <-chan int) {
   time.Sleep(2 * time.Second)
   fmt.Println("print int", <-u)
}

func main() {
   c := make(chan int, 5)
   a := 0

   c <- a
   fmt.Println(a)
   // modify g
   a = 1

   go print(c)
   time.Sleep(5 * time.Second)
   fmt.Println(a)
}
